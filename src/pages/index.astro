---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ScreenSwitcher from '../components/ScreenSwitcher.astro';
import StatusPill from '../components/StatusPill.astro';

const base = import.meta.env.BASE_URL;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.find((p) => p.data.featured);
const statusOrder = ['released', 'in-build', 'queued', 'idea'] as const;
const statusLabels = { released: 'Released', 'in-build': 'In build', queued: 'Queued', idea: 'Idea' };
const counts = Object.fromEntries(statusOrder.map((s) => [s, projects.filter((p) => p.data.status === s).length]));
const filters = statusOrder.filter((s) => counts[s] > 0);
const summary = filters.map((s) => `${counts[s]} ${statusLabels[s].toLowerCase()}`).join(' · ');
const coverOf = (p: (typeof projects)[number]) => p.data.screens[0]?.tablet ?? p.data.screens[0]?.phone;
---
<Base>
  <section class="hero">
    <div class="wrap">
      <div class="intro">
        <div>
          <div class="label pill glass">Open-source tools · built with Claude</div>
          <h1><span class="dim">Useful tech,</span> built in public and checked before you run it.</h1>
          <p class="lede">I'm Merri, a security consultant in Chennai. I build small tools and gadgets with Claude, review them the way I'd review a client's system, then release the code so you can build your own.</p>
        </div>
        <div class="side-copy">
          {featured?.data.repo && (
            <div class="prompt glass" aria-label="Clone command"><b>$</b><span>git clone {featured.data.repo.replace('https://', '')}</span></div>
          )}
          <div class="cta">
            <a class="btn liquid tint" href="#projects">See the builds</a>
            <a class="btn liquid" href="https://github.com/Nightshade-22" target="_blank" rel="noopener">GitHub ↗</a>
          </div>
        </div>
      </div>

      {featured && (
        <div class="featured">
          <div class="featured-head">
            <span class="label">Featured build</span>
            <a href={`${base}projects/${featured.id}/`}><strong>{featured.data.name}</strong></a>
            <StatusPill status={featured.data.status} />
          </div>
          <ScreenSwitcher name={featured.data.name} screens={featured.data.screens} />
        </div>
      )}
    </div>
  </section>

  <section id="projects">
    <div class="wrap">
      <div class="sec-head">
        <h2>Projects</h2>
        <span class="label">{summary}</span>
      </div>
      {filters.length > 1 && (
        <div class="seg liquid filters" role="group" aria-label="Filter projects">
          <button type="button" data-filter="all" aria-pressed="true">All</button>
          {filters.map((s) => <button type="button" data-filter={s} aria-pressed="false">{statusLabels[s]}</button>)}
        </div>
      )}
      <div class="grid">
        {projects.map((p) => (
          <ProjectCard slug={p.id} name={p.data.name} pitch={p.data.pitch} status={p.data.status} tags={p.data.tags} cover={coverOf(p)} controls={p.data.review?.controls.map((c) => c.title)} />
        ))}
      </div>
      <p class="empty" hidden>No projects with that status yet.</p>
    </div>
  </section>

  <section id="process">
    <div class="wrap">
      <div class="sec-head"><h2>How every build ships</h2><span class="label">same steps, every time</span></div>
      <ol class="steps">
        <li class="glass"><h4>Build with Claude</h4><p>The whole build is on camera, including the prompts that worked and the ones that didn't.</p></li>
        <li class="glass"><h4>Review it like an auditor</h4><p>What the AI got wrong, what was exposed, and what I changed before release.</p></li>
        <li class="glass"><h4>Release the code</h4><p>Public repo, setup guide, and a short demo. AI-assisted code is labelled as such.</p></li>
      </ol>
    </div>
  </section>

  <section id="follow">
    <div class="wrap">
      <div class="sec-head"><h2>Follow the builds</h2></div>
      <div class="channels">
        <a class="ch glass" href="https://www.youtube.com/@merri.builds" target="_blank" rel="noopener"><strong>YouTube</strong><span>@merri.builds ↗</span></a>
        <a class="ch glass" href="https://www.instagram.com/merri.builds/" target="_blank" rel="noopener"><strong>Instagram</strong><span>@merri.builds ↗</span></a>
        <a class="ch glass" href="https://github.com/Nightshade-22" target="_blank" rel="noopener"><strong>GitHub</strong><span>@Nightshade-22 ↗</span></a>
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('.grid > .card');
  const empty = document.querySelector<HTMLElement>('#projects .empty');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter;
      let shown = 0;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      cards.forEach((c) => {
        const on = f === 'all' || c.dataset.status === f;
        c.hidden = !on;
        if (on) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    })
  );
</script>

<style>
  .hero .wrap { display: grid; gap: 40px; padding-block: 36px 8px; }
  .intro { display: grid; grid-template-columns: 1.2fr .8fr; gap: 40px; align-items: end; }
  .side-copy { display: flex; flex-direction: column; gap: 16px; }
  .pill { display: inline-flex; padding: 6px 12px; border-radius: 99px; }
  h1 { font-weight: 700; font-size: clamp(36px, 6.4vw, 64px); line-height: 1.04; letter-spacing: -.03em; margin: 14px 0 20px; }
  .dim { color: color-mix(in srgb, var(--fg) 45%, transparent); }
  .lede { font-size: 18px; color: var(--muted); max-width: 52ch; margin: 0; }
  .prompt { font-family: var(--f-code); font-size: 14px; border-radius: 12px; padding: 12px 16px; display: flex; gap: 10px; align-items: center; overflow-x: auto; white-space: nowrap; }
  .prompt b { font-weight: 500; color: var(--muted); }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .featured { display: flex; flex-direction: column; gap: 16px; }
  .featured-head { display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap; }
  .featured-head a { text-decoration: none; font-size: 18px; }
  .filters { margin-bottom: 20px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 16px; }
  .empty { color: var(--muted); }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; list-style: none; padding: 0; margin: 0; counter-reset: s; }
  .steps li { padding: 24px; border-radius: 12px; counter-increment: s; }
  .steps li::before { content: "0" counter(s); font-weight: 800; font-size: 28px; display: block; margin-bottom: 10px; letter-spacing: -.03em; }
  .steps h4 { margin: 0 0 6px; font-size: 17px; font-weight: 600; }
  .steps p { margin: 0; color: var(--muted); font-size: 15px; }
  .channels { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .ch { border-radius: 12px; padding: 20px 22px; display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: var(--fg); }
  .ch strong { font-size: 16px; }
  .ch span { font-size: 13px; color: var(--muted); }
  a.ch:hover { border-color: color-mix(in srgb, var(--fg) 30%, transparent); }
  @media (max-width: 820px) {
    .intro { grid-template-columns: 1fr; gap: 20px; }
    .steps, .channels { grid-template-columns: 1fr; }
  }
</style>
